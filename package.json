{
  "name": "mingo-mongo-mock",
  "version": "0.2.1",
  "description": "MongoDB-driver-shaped in-memory mock collections powered by mingo.",
  "repository": {
    "type": "git",
    "url": "https://github.com/james-tindal/mingo-mongo-mock"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "readme.md"
  ],
  "sideEffects": false,
  "keywords": [
    "mongo",
    "mongodb",
    "mock",
    "mingo",
    "test",
    "in-memory"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@types/node": "^26.1.2",
    "mingo": "^7.2.2",
    "mongodb": "^7.5.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
